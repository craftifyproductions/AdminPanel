# Cloudflare account ID. The R2 S3 endpoint is derived as
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# R2 API token credentials (Cloudflare dashboard -> R2 -> Manage API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket this panel manages
R2_BUCKET_NAME=

# Optional. Public base URL (custom domain or r2.dev) used to build object links.
R2_PUBLIC_URL=

# Random secret used to sign the session cookie, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# --- Auth (preferred): Supabase Auth email/password ---
# When both are set, login uses signInWithPassword (anon key is correct for user login).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role — server only. Used for admin data browse + activity logs inserts/reads.
# Never expose to the browser. Run supabase/admin_activity_logs.sql in the SQL Editor first.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Comma-separated public table allowlist used when schema introspection fails.
SUPABASE_TABLES=

# --- Legacy emergency login (off by default) ---
# Only used when SUPABASE_URL + SUPABASE_ANON_KEY are missing AND this is true.
ALLOW_LEGACY_ADMIN_LOGIN=false
ADMIN_PASSWORD=

# Optional. API key from https://openrouter.ai (Keys). Not required for R2 or login.
OPENROUTER_API_KEY=

# Optional. OpenRouter chat model id, e.g. openai/gpt-4o-mini
OPENROUTER_MODEL_ID=

# Optional. OpenRouter vision/image model id for chat attachments (falls back to chat model)
OPENROUTER_IMAGE_MODEL_ID=
